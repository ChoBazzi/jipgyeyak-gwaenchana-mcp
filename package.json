  "main": "dist/stdio.js",
  "bin": {
    "jipgyeyak-gwaenchana-mcp": "dist/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:http": "tsx watch src/http.ts",
